# Yanchi AI — Environment Variables
# Copy this file to .env and fill in your values

APP_NAME="Yanchi AI"
VERSION="1.0.0"
DEBUG=false

# OpenAI API key (used for enhanced legal Q&A generation)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Path where ChromaDB persists its vector data
VECTOR_DB_PATH=./chroma_db

# Ghost-mode session TTL in seconds (default 300 = 5 minutes)
EPHEMERAL_SESSION_TTL_SECONDS=300

# Comma-separated list of allowed CORS origins; use * for all
ALLOWED_ORIGINS=["*"]
